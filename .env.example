# ════════════════════════════════════════════
#  Mobile Automation Framework — Environment
#  Copy to .env and fill in your values
# ════════════════════════════════════════════

# Platform: android | ios
PLATFORM=android

# Appium server
APPIUM_URL=http://127.0.0.1:4723

# ─── Android ────────────────────────────────
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=12.0

# Path to APK (leave empty to use package/activity below)
ANDROID_APP_PATH=

# Launch existing installed app
ANDROID_APP_PACKAGE=com.example.app
ANDROID_APP_ACTIVITY=com.example.app.MainActivity

# ─── iOS ────────────────────────────────────
IOS_DEVICE_NAME=iPhone 14 Simulator
IOS_PLATFORM_VERSION=16.4
IOS_UDID=

IOS_APP_PATH=
IOS_BUNDLE_ID=com.example.app

# ─── Test credentials ───────────────────────
VALID_USERNAME=testuser@example.com
VALID_PASSWORD=Test@1234
